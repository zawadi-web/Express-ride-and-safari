# Express Ride & Safaris Kenya - Environment Variables
# Configure these in your Vercel Project Settings -> Environment Variables

# The Gmail address to send from & receive notifications
GMAIL_USER=expressridesandsafaris@gmail.com

# 16-character Google App Password (NOT your normal Gmail password)
# To create an App Password:
# 1. Go to your Google Account (myaccount.google.com)
# 2. Go to Security -> 2-Step Verification (turn on if not already active)
# 3. Search for "App Passwords" or scroll to the bottom of 2-Step Verification
# 4. Create an App name (e.g. "Express Ride Website")
# 5. Copy the 16-character password into GMAIL_APP_PASSWORD
GMAIL_APP_PASSWORD=
